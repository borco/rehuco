         <string>Screenshot name patterns</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="ScreenshotNamePatternsEditor" name="patterns_editor">
        <property name="toolTip">
         <string>Each pattern is a regular expression matched against a filename's stem, case-insensitively. One capture group names the slot as a number; no capture group means slot 0. Double-click a cell to edit it.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="patterns_order_label">
        <property name="text">
         <string>Order matters only for which pattern matches first when more than one could: an ordinary list, evaluated top to bottom, first match wins. A pattern that fails to compile, or carries more than one capture group, is skipped and shown in red. An empty list falls back to the shipped patterns.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="tie_break_frame">
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
