      <item>
       <widget class="QLabel" name="tie_break_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Always applied</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="tie_break_label">
        <property name="text">
         <string>When several files land on the same slot, the one kept is the largest by pixel size, then a .jpg or .jpeg over any other format, then the first by name. The others are still backed up when a resource is converted.</string>
        </property>
        <property name="toolTip">
         <string>This ranking is not configurable — it applies whatever the patterns above say.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
