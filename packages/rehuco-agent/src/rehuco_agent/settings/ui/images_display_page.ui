      <item>
       <widget class="QLabel" name="surface_hint_label">
        <property name="text">
         <string>Where an image opens when it is double-clicked, unless a key held down picks another surface:</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="document_overlay_radio_button">
        <property name="text">
         <string>rehu window overlay (or SHIFT)</string>
        </property>
        <property name="toolTip">
         <string>Covers the open document, leaving its tab and the app's menus and toolbars visible. Holding SHIFT while double-clicking opens this way whatever is chosen here.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="app_window_overlay_radio_button">
        <property name="text">
         <string>app window overlay (or CTRL)</string>
        </property>
        <property name="toolTip">
         <string>Covers the whole main window, leaving only its menu, tool, and status bars visible. Holding CTRL while double-clicking opens this way whatever is chosen here.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="full_screen_radio_button">
        <property name="text">
         <string>frameless full-screen (or CTRL+SHIFT)</string>
        </property>
        <property name="toolTip">
         <string>Covers the entire screen, with no window frame. Holding CTRL+SHIFT while double-clicking opens this way whatever is chosen here.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="lightbox_info_check_box">
        <property name="text">
         <string>Show image info</string>
        </property>
        <property name="toolTip">
         <string>Whether a maximized image shows its name, pixel size and file size in the corner. The I key toggles it in an open viewer; applying this sets every open viewer too.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="strip_visible_check_box">
        <property name="text">
         <string>Show the thumbnail strip</string>
        </property>
        <property name="toolTip">
         <string>Whether a maximized screenshot opens with its thumbnail strip shown. Each document remembers its own strip, so this only decides what a document that has never shown one starts with.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="lightbox_double_click_check_box">
        <property name="text">
         <string>Double-click closes the viewer</string>
        </property>
        <property name="toolTip">
         <string>Whether a double-click on the maximized image closes the viewer -- the gesture that opened it, undoing it. Applying this sets every open viewer too.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="lightbox_select_last_check_box">
        <property name="text">
         <string>Focus and select the last image viewed in the viewer</string>
        </property>
        <property name="toolTip">
         <string>Whether closing a viewer opened from the Content Images panel selects, in the panel, the image it was on -- scrolled into view, its group expanded if it was collapsed. Read when a viewer closes, so it applies to one already open.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
