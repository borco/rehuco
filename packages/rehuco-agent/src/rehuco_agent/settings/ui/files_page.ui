   <item>
    <widget class="QFrame" name="deletion_frame">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
     <layout class="QVBoxLayout" name="deletion_frame_layout">
      <item>
       <widget class="QLabel" name="deletion_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Deleting files</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="use_recycle_bin_check_box">
        <property name="text">
         <string>Move deleted files to the Recycle Bin, if possible</string>
        </property>
        <property name="toolTip">
         <string>A file this app deletes on the user's behalf goes to the Recycle Bin / Trash when one is reachable for it, with no question asked. Where none is -- a network share, the mounted NAS -- the file is deleted permanently instead.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="permanent_delete_label">
        <property name="text">
         <string>A permanent delete — the Recycle Bin off, or none reachable for the file — is confirmed first, unless:</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="clear_backups_without_asking_check_box">
        <property name="text">
         <string>Clear backups without asking</string>
        </property>
        <property name="toolTip">
         <string>Permanently delete a conversion's .orig backups -- Convert, Discard Originals, a document's Discard Backups action, the Conversion Backups dialog -- without a confirmation. Every such confirmation carries this same box. A queued discard from the Conversion Backups dialog has no window to ask from once it runs, so with this off the dialog asks once per batch where it can already tell no Recycle Bin is reachable (Windows), and elsewhere a refused resource fails and leaves its backups in place.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="delete_images_without_asking_check_box">
        <property name="text">
         <string>Delete images without asking</string>
        </property>
        <property name="toolTip">
         <string>Permanently delete a screenshot from the images editor without a confirmation.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="moving_frame">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
     <layout class="QVBoxLayout" name="moving_frame_layout">
      <item>
       <widget class="QLabel" name="moving_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Moving records</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="remove_empty_folders_check_box">
        <property name="text">
         <string>Remove the left-behind folders up to the root, only while each is empty</string>
        </property>
        <property name="toolTip">
         <string>After a record moves to the place its root's layout gives it, the folder it left -- and each folder above it, up to the root -- is removed while it is empty. A folder holding anything else is left, and so is every folder above it.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="verifying_frame">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
     <layout class="QVBoxLayout" name="verifying_frame_layout">
      <item>
       <widget class="QLabel" name="verifying_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Verify checksums when moving a record</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="renamed_label">
        <property name="text">
         <string>Renamed in place</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="verify_renamed_local_check_box">
        <property name="text">
         <string>on a local disk</string>
        </property>
        <property name="toolTip">
         <string>A record moved to another folder on the same local, removable or disc volume is renamed there, which rewrites no bytes. With this on, its checksums are verified before and after, as a task.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="verify_renamed_network_check_box">
        <property name="text">
         <string>on a network share</string>
        </property>
        <property name="toolTip">
         <string>A record moved to another folder on the same share is renamed by the server. With this on, its checksums are verified before and after, as a task.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="copied_label">
        <property name="text">
         <string>Copied to another disk or share</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="verify_original_check_box">
        <property name="text">
         <string>check the original before copying</string>
        </property>
        <property name="toolTip">
         <string>The copy is checked against the record's checksums, which only proves something if the original still matches them. A record missing checksums is verified first whatever this says, when Create missing checksum on verify is on, and refused when it is off.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="verify_copy_check_box">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="text">
         <string>check the copy before removing the original</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>Always: the original is removed only once its copy matched every checksum.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="patterns_frame">
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
     <layout class="QVBoxLayout" name="patterns_frame_layout">
      <item>
       <widget class="QLabel" name="patterns_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Excluded file patterns</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="StringListEditor" name="patterns_editor">
        <property name="toolTip">
         <string>Files whose name matches one of these are left out of size scans and checksums. Double-click an entry to edit it.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="patterns_note_label">
        <property name="text">
         <string>Matched against the file name only, so a pattern can never exclude a whole folder. An empty list falls back to the shipped patterns. Sizes and checksums already computed are not recalculated by a change here.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="structural_frame">
     <property name="frameShape">
      <enum>QFrame::Shape::StyledPanel</enum>
     </property>
     <property name="frameShadow">
      <enum>QFrame::Shadow::Raised</enum>
     </property>
     <layout class="QVBoxLayout" name="structural_frame_layout">
      <item>
       <widget class="QLabel" name="structural_frame_label">
        <property name="font">
         <font>
          <bold>true</bold>
         </font>
        </property>
        <property name="text">
         <string>Always excluded</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="structural_patterns_label">
        <property name="textInteractionFlags">
         <set>Qt::TextInteractionFlag::TextSelectableByMouse|Qt::TextInteractionFlag::TextSelectableByKeyboard</set>
        </property>
        <property name="toolTip">
         <string>Derived from each record's own name, wherever it is found — these cannot be changed.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="WrappingLabel" name="structural_note_label">
        <property name="text">
         <string>These change whenever a resource is edited, so counting them would mean recomputing after every edit. Every record found while scanning is treated this way, nested ones included — their content still counts. A file is skipped only when a record of that name sits beside it.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="bottom_spacer">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
