{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "rehuco-agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/rehuco-agent/src/rehuco_agent/__main__.py",
            "console": "integratedTerminal",
            // The venv layout differs per OS (bin/python vs Scripts/python.exe), and this repo is
            // opened both natively on Windows and over Remote-SSH on Linux.
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        },
        {
            // Linux-only: renders on the host's GNOME Wayland session (visible in the Hyper-V
            // console), since a Remote-SSH shell inherits no display environment of its own.
            "name": "rehuco-agent (remote)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/rehuco-agent/src/rehuco_agent/__main__.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "XDG_RUNTIME_DIR": "/run/user/1000",
                "WAYLAND_DISPLAY": "wayland-0",
                "QT_QPA_PLATFORM": "wayland",
            }
        },
        {
            "name": "windows | rehuco-agent-dev-launcher",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/packages/rehuco-agent/launcher/Release/rehuco-agent-dev.exe",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
    ]
}
